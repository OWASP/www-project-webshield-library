{
  "name": "@owasp-webshield/core",
  "version": "1.0.0",
  "description": "OWL (OWASP Webshield Library): practical OWASP Top 10 mitigation helpers for JavaScript apps",
  "private": false,
  "type": "module",
  "workspaces": [
    "src/adapters/react",
    "src/adapters/node",
    "src/adapters/express",
    "src/adapters/vue",
    "src/adapters/next"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWASP/www-project-webshield-library.git"
  },
  "homepage": "https://owasp.org/www-project-webshield-library/",
  "bugs": {
    "url": "https://github.com/OWASP/www-project-webshield-library/issues"
  },
  "author": "OWASP Webshield Library Project",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./modules/*": {
      "types": "./dist/core/*",
      "default": "./src/core/*"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/core",
    "!src/core/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:browser && npm run build:types",
    "build:esm": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=dist/index.js",
    "build:cjs": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "build:browser": "esbuild src/index.browser.js --bundle --platform=browser --format=esm --outfile=dist/index.browser.js",
    "build:types": "node scripts/build-types.mjs",
    "typecheck": "tsc --project tsconfig.types.json --noEmit && tsc --project tsconfig.react.types.json --noEmit && tsc --project tsconfig.vue.types.json --noEmit && tsc --project tsconfig.node.types.json --noEmit && tsc --project tsconfig.express.types.json --noEmit && tsc --project tsconfig.next.types.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run typecheck",
    "lint:docs": "node scripts/ci/check-doc-links.mjs",
    "prepublishOnly": "npm run check && npm run build && npm pack --dry-run"
  },
  "keywords": [
    "owasp",
    "owasp-top10",
    "security",
    "javascript",
    "typescript",
    "react",
    "webshield",
    "rbac",
    "acl",
    "csrf",
    "ssrf",
    "authentication",
    "authorization",
    "crypto",
    "input-sanitization",
    "secure-coding"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://owasp.org/donate/"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/react": "^16.1.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
