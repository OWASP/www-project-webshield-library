{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@owasp-webshield/core": [
        "src/index.js"
      ],
      "@owasp-webshield/react": [
        "src/adapters/react/index.js"
      ],
      "@owasp-webshield/vue": [
        "src/adapters/vue/index.js"
      ],
      "@owasp-webshield/node": [
        "src/adapters/node/index.js"
      ],
      "@owasp-webshield/express": [
        "src/adapters/express/index.js"
      ],
      "@owasp-webshield/next": [
        "src/adapters/next/index.js"
      ]
    },
    "checkJs": false,
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
