{
  "name": "@owasp-webshield/next",
  "version": "2.0.0",
  "description": "Next.js adapter for OWL (OWASP Webshield Library): App Router route handler guards, middleware CSRF checks, security headers, server-side sessions and client components",
  "private": false,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWASP/www-project-webshield-library.git",
    "directory": "src/adapters/next"
  },
  "homepage": "https://owasp.org/www-project-webshield-library/",
  "bugs": {
    "url": "https://github.com/OWASP/www-project-webshield-library/issues"
  },
  "author": "OWASP Webshield Library Project",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "owasp",
    "owasp-top10",
    "security",
    "nextjs",
    "next",
    "app-router",
    "route-handlers",
    "middleware",
    "webshield",
    "rbac",
    "csrf",
    "ssrf",
    "security-headers",
    "content-security-policy",
    "authentication",
    "authorization",
    "input-validation",
    "secure-coding"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://owasp.org/donate/"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@owasp-webshield/node": "file:../node",
    "@owasp-webshield/react": "file:../react"
  }
}
