{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.js",
    "src/index.browser.js",
    "src/core/**/*.js"
  ]
}